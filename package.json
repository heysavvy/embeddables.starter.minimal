{
  "name": "embeddables-starter-minimal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && em build && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
