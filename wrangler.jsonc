{
  // `vite build` writes the Worker to dist/app and the static files to dist/client, the paths
  // `hosting.apps` in embeddables/config.yaml deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": { "binding": "ASSETS" },
  // The project's publishable key. It is public by design, so it can live here; `vite build`
  // reads it into the app when EMBEDDABLES_PUBLISHABLE_KEY is not set in the environment.
  "vars": { "EMBEDDABLES_PUBLISHABLE_KEY": "" },
}
