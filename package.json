    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "preview": "vite preview"
  },
  "dependencies": {
    "@embeddables/analytics": "^0.2.0",
    "@embeddables/core": "^0.3.1",
    "@embeddables/forms": "^0.4.1",
